{
  "schema_version": "1.3",
  "name": "UK Higher Education Lab Report Default Rubric",
  "effective_date": "2026-10-23",
  "default_level": {
    "england_wales_northern_ireland": "FHEQ Level 6",
    "scotland": "FQHEIS Level 10",
    "description": "Final-year undergraduate"
  },
  "purpose": "System-owned independent AI assessment baseline for overall lab report quality",
  "citation_policy": {
    "citations_required": true,
    "style_id": null,
    "style_version": null,
    "source": "system_default",
    "institution_overrides": [],
    "when_style_unspecified": "check_linkage_and_field_completeness_only"
  },
  "evaluation_tracks": {
    "ai_default": {
      "rubric": "this_default_rubric",
      "score_label": "AI default assessment",
      "active_for_system_overall_assessment": true,
      "official_institutional_grade": false
    },
    "user_custom": {
      "rubric": "user_uploaded_or_selected_rubric",
      "score_label": "Custom/course rubric assessment",
      "active_when_selected": true,
      "official_institutional_grade": false
    },
    "default_display_mode_when_custom_exists": "parallel",
    "allowed_display_modes": ["parallel", "ai_default_only", "custom_only"],
    "combine_or_average_track_scores": false
  },
  "custom_rubric_support": {
    "enabled": true,
    "accepted_formats": ["pdf", "image", "docx", "xlsx", "csv", "json", "txt"],
    "scope_options": ["current_evaluation", "saved_named_profile"],
    "display_mode_options": ["parallel", "ai_default_only", "custom_only"],
    "allow_arbitrary_positive_max_score": true,
    "preserve_original_scale_by_default": true,
    "allow_optional_percentage_conversion": true,
    "silent_default_weight_injection": false,
    "allow_switch_back_to_default": true,
    "required_provenance": ["name", "version_if_available", "maximum_score", "source"],
    "validation": {
      "require_positive_maximum_score": true,
      "weighted_criteria_target_percent": 100,
      "weight_rounding_tolerance_percent": 0.01,
      "flag_overlapping_or_out_of_range_bands": true,
      "flag_conflicting_caps_penalties_or_thresholds": true,
      "missing_weights_policy": "request_confirmation_or_explicitly_label_equal_weight_temporary_interpretation",
      "uncovered_default_criteria_policy": "non_scoring_advice_only"
    }
  },
  "scale": {
    "minimum": 0,
    "maximum": 100,
    "bands": [
      {"min": 80, "max": 100, "label": "High/Exceptional First"},
      {"min": 70, "max": 79, "label": "First (1st)"},
      {"min": 60, "max": 69, "label": "Upper Second (2:1)"},
      {"min": 50, "max": 59, "label": "Lower Second (2:2)"},
      {"min": 40, "max": 49, "label": "Third / Pass"},
      {"min": 0, "max": 39, "label": "Fail"}
    ],
    "suggested_anchor_scores": [0, 15, 25, 35, 42, 45, 48, 52, 55, 58, 62, 65, 68, 72, 75, 78, 83, 94, 100]
  },
  "criteria": [
    {"id": "A", "name": "Research purpose, context and theory", "weight": 12},
    {"id": "B", "name": "Experimental design and methodological reproducibility", "weight": 15},
    {"id": "C", "name": "Results and data presentation", "weight": 15},
    {"id": "D", "name": "Data analysis, statistics and uncertainty", "weight": 15},
    {"id": "E", "name": "Discussion, interpretation and critical evaluation", "weight": 23},
    {"id": "F", "name": "Abstract and conclusion", "weight": 8},
    {"id": "G", "name": "Structure, scientific writing and professional presentation", "weight": 7},
    {"id": "H", "name": "Evidence use, referencing and academic conventions", "weight": 5}
  ],
  "calculation": "sum(criterion_percentage * criterion_weight / 100), rounded to nearest integer",
  "integrity_policy": "Flag suspected academic misconduct for the institution's formal process; do not apply a universal deduction or automatic zero.",
  "required_output": [
    "ai_default_score_and_band",
    "ai_estimate_not_official_grade_label",
    "applicable_requirements_and_adjustments",
    "criterion_scores_with_evidence_and_improvement",
    "top_three_priority_revisions",
    "confidence_and_limitations",
    "integrity_or_verifiability_flag_if_evidenced",
    "custom_track_score_and_provenance_if_selected"
  ],
  "human_readable_spec": "DEFAULT_LAB_REPORT_RUBRIC.md"
}
