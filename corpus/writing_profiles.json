      "focus": [
        "问题与依据",
        "研究设计和分析计划",
        "可行性",
        "适用的伦理考虑"
      ],
      "cautions": [
        "拟开展的研究不需要已经产生实验结果。",
        "不把预期结果当作已验证事实；伦理要求按具体任务判断。"
      ],
      "criteria": [
        {
          "id": "criterion_1",
          "name": "研究问题与依据",
          "maximum_points": 25,
          "descriptor": "问题明确，研究必要性有依据并限定范围。"
        },
        {
          "id": "criterion_2",
