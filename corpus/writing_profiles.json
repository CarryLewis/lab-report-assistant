      "id": "lab_report",
      "name": "实验报告",
      "aliases": [
        "Lab Report"
      ],
      "version": "1",
      "description": "依据实验目的、方法、数据与解释评阅实验写作。",
      "instructions": "说明实验任务、学习目标、数据要求与允许的方法；按课程要求判断是否需要重复、图表及引用。",
      "focus": [
        "实验目的与科学背景",
        "方法可复核性",
        "结果与解释的区分",
        "证据和局限"
      ],
      "cautions": [
        "仅在作业要求适用时检查实验结构、对照、重复和统计检验。",
        "不得从图像推断未提供的原始数据或实验事实。"
      ],
      "criteria": [
        {
          "id": "criterion_1",
          "name": "目的与背景",
          "maximum_points": 15,
          "descriptor": "解释研究目的及其与背景的联系。"
        },
        {
          "id": "criterion_2",
          "name": "方法与可复核性",
          "maximum_points": 20,
          "descriptor": "说明实际方法及影响理解的条件；按任务核对细节。"
        },
        {
          "id": "criterion_3",
          "name": "结果与证据呈现",
          "maximum_points": 25,
          "descriptor": "准确组织已提供的数据、表格与图像，区分观察与推断。"
        },
        {
          "id": "criterion_4",
          "name": "讨论与局限",
          "maximum_points": 25,
          "descriptor": "以结果支持解释，讨论适用范围及替代解释。"
        },
        {
          "id": "criterion_5",
          "name": "组织、语言与引用",
          "maximum_points": 15,
          "descriptor": "结构清楚、表达准确；按本次要求核对引用。"
        }
      ],
